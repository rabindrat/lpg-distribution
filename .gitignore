# Databases & Local Settings
# ==========================================
# Exclude local SQLite database
*.sqlite3
db.sqlite3

# Exclude local settings files that contain secrets
local_settings.py
.env
.secrets/

# ==========================================
# Django Media & Assets
# ==========================================
# Never track user-uploaded media files
media/
media_root/

# Optional: Ignore collected static files if you run collectstatic in deployment
# static/
# staticfiles/

