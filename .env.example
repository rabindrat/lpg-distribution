# Local defaults / Railway service variables
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgres://user:password@host:5432/database
ALLOWED_HOSTS=your-service.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app

# Railway terminates TLS at the edge. Keep false unless health probes forward
# X-Forwarded-Proto=https and you have verified the /health endpoint.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000

# Optional: mount a Railway volume at /data for dealer uploads.
MEDIA_ROOT=/data/media

# Optional SMTP settings when transactional email is introduced.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-me
# EMAIL_HOST_PASSWORD=replace-me
# EMAIL_USE_TLS=true
